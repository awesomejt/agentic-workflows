{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesomejt.github.io/agentic-workflows/schemas/source-manifest.schema.json",
  "title": "Agentic workflow source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sources"],
  "properties": {
    "schema_version": { "const": 1 },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "remote", "checkout_hint", "content", "status"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "remote": { "type": "string", "minLength": 1 },
          "checkout_hint": { "type": "string", "minLength": 1 },
          "content": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "status": {
            "enum": ["inventory", "review", "migrating", "complete", "reference-only"]
          },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  }
}
