{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesomejt.github.io/agentic-workflows/schemas/secret-catalog.schema.json",
  "title": "Secret reference catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "secrets"],
  "properties": {
    "schema_version": { "const": 1 },
    "secrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "purpose", "consumers", "source", "validation"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "purpose": { "type": "string", "minLength": 1 },
          "consumers": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/id" }
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "locator"],
            "properties": {
              "type": {
                "enum": ["ansible-vault", "hashicorp-vault", "environment", "tool-native"]
              },
              "host": { "type": "string" },
              "locator": { "type": "string", "minLength": 1 },
              "variable": { "type": "string", "minLength": 1 }
            }
          },
          "owner": { "type": "string" },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type"],
            "properties": {
              "type": { "enum": ["environment-present", "file-present", "external"] },
              "variable": { "type": "string" },
              "path": { "type": "string" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  }
}
