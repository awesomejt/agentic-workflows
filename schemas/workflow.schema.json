{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesomejt.github.io/agentic-workflows/schemas/workflow.schema.json",
  "title": "Reset-safe agent workflow",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "description", "execution", "entry_stage", "stages", "completion_gates"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/id" },
    "description": { "type": "string", "minLength": 1 },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state_root", "context_policy", "max_passes"],
      "properties": {
        "state_root": { "const": ".agents/loop" },
        "context_policy": { "const": "reset-after-pass" },
        "max_passes": { "type": "integer", "minimum": 1 }
      }
    },
    "entry_stage": { "$ref": "#/$defs/id" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "purpose", "on_success"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "role": { "$ref": "#/$defs/id" },
          "purpose": { "type": "string", "minLength": 1 },
          "optional": { "type": "boolean", "default": false },
          "on_success": { "$ref": "#/$defs/transition" },
          "on_failure": { "$ref": "#/$defs/transition" }
        }
      }
    },
    "completion_gates": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "transition": {
      "anyOf": [
        { "$ref": "#/$defs/id" },
        { "enum": ["complete", "blocked"] }
      ]
    }
  }
}
