{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesomejt.github.io/agentic-workflows/schemas/service-contract.schema.json",
  "title": "AI service client contract",
  "type": "object",
  "required": ["schema_version", "service_ref", "owner"],
  "properties": {
    "schema_version": { "const": 1 },
    "service_ref": { "$ref": "#/$defs/id" },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "path", "observed_revision"],
      "properties": {
        "repository": { "$ref": "#/$defs/id" },
        "path": { "type": "string", "minLength": 1 },
        "observed_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
      }
    },
    "secret_refs": {
      "type": "array",
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "notes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  }
}
