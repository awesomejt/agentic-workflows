{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awesomejt.github.io/agentic-workflows/schemas/template-catalog.schema.json",
  "title": "Reusable project template catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "templates"],
  "properties": {
    "schema_version": { "const": 1 },
    "templates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "source", "source_revision", "purpose", "status", "source_paths"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "source": { "$ref": "#/$defs/id" },
          "source_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "purpose": { "type": "string", "minLength": 1 },
          "status": { "enum": ["reference", "normalize", "ready", "superseded"] },
          "source_paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "shared_assets": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
  }
}
